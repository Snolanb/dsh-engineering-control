{
  "name": "dsh-engineering-control",
  "version": "0.1.0",
  "description": "Monorepo for the DSH task orchestration and change governance plugins and their integration package.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
