    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
    }
  },
  "packageManager": "pnpm@10.28.0"
