{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "../task-orchestrator/lib",
    "../change-control/lib"
  ]
}
