{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "checkJs": true,
    "noEmit": true,
    "paths": {
      "dsh-task-orchestrator/dispatcher": [
        "./src/dispatcher.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "../task-orchestrator/lib",
    "../change-control/lib"
  ]
}
